    if gp then return end
    if input.KeyCode == FogConfig.MenuKey then
        ScreenGui.Enabled = not ScreenGui.Enabled
    elseif input.KeyCode == FogConfig.ToggleKey then
        FogConfig.Enabled = not FogConfig.Enabled
        apply_fog()
    end
end)

