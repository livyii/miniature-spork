local function addSlider(label, min, max, getValue, setValue, decimals)
    decimals = decimals or 2
    local card = Instance.new("Frame", Scroll)
    card.Size = UDim2.new(1, 0, 0, 44)
    card.BackgroundColor3 = Theme.Surface
    card.BackgroundTransparency = 0.05
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 11)
    local cs = Instance.new("UIStroke", card)
    cs.Color = Theme.Stroke
    cs.Thickness = 1

    local lbl = Instance.new("TextLabel", card)
    lbl.Size = UDim2.new(1, -70, 0, 16)
    lbl.Position = UDim2.new(0, 12, 0, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = Theme.TextMain
    lbl.TextSize = 11
    lbl.Font = FontConfig.Body
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local badge = Instance.new("Frame", card)
    badge.Size = UDim2.new(0, 46, 0, 18)
    badge.Position = UDim2.new(1, -58, 0, 6)
    badge.BackgroundColor3 = Theme.Accent
    Instance.new("UICorner", badge).CornerRadius = UDim.new(1, 0)
    local bs = Instance.new("UIStroke", badge)
    bs.Color = Theme.Stroke
    bs.Thickness = 1

    local valLbl = Instance.new("TextLabel", badge)
    valLbl.Size = UDim2.new(1, 0, 1, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = string.format("%." .. decimals .. "f", getValue())
    valLbl.TextColor3 = Theme.Bg
    valLbl.TextSize = 9
    valLbl.Font = FontConfig.Bold

    local track = Instance.new("Frame", card)
    track.Size = UDim2.new(1, -24, 0, 5)
    track.Position = UDim2.new(0, 12, 0, 30)
    track.BackgroundColor3 = Theme.Bg
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    local pct = math.clamp((getValue() - min) / (max - min), 0, 1)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = Theme.Accent
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("TextButton", track)
    knob.Size = UDim2.new(0, 13, 0, 13)
    knob.Position = UDim2.new(pct, -6, 0.5, -6)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Text = ""
    knob.AutoButtonColor = false
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local ks = Instance.new("UIStroke", knob)
    ks.Color = Theme.Stroke
    ks.Thickness = 1.5

    local isDragging = false
    local function update(xPos)
        local p = math.clamp((xPos - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local raw = min + (max - min) * p
        local val
        if decimals == 0 then
            val = math.floor(raw + 0.5)
        else
            local m = 10 ^ decimals
            val = math.floor(raw * m + 0.5) / m
        end
        setValue(val)
        valLbl.Text = string.format("%." .. decimals .. "f", val)
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, -6, 0.5, -6)
    end

    knob.MouseButton1Down:Connect(function() isDragging = true end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            update(input.Position.X)
        end
    end)
end

