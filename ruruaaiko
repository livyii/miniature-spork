-- ═══════════════════════════════════════════════════
-- CHARACTER GLOW LOGIC
-- ═══════════════════════════════════════════════════
local characterHighlight = nil

local function update_character_glow()
    local char = LocalPlayer.Character
    if not char then return end

    if FogConfig.Enabled and FogConfig.GlowCharacter then
        if not characterHighlight or characterHighlight.Parent ~= char then
            if characterHighlight then characterHighlight:Destroy() end
            characterHighlight = Instance.new("Highlight")
            characterHighlight.Name = "FogGlowHighlight"
            characterHighlight.Adornee = char
            characterHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            characterHighlight.FillTransparency = 0.5
            characterHighlight.OutlineTransparency = 1
            characterHighlight.FillColor = FogConfig.GlowColor
            characterHighlight.Parent = char
        else
            characterHighlight.Enabled = true
            characterHighlight.FillColor = FogConfig.GlowColor
        end
    else
        if characterHighlight then
            characterHighlight:Destroy()
            characterHighlight = nil
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    update_character_glow()
end)

-- ═══════════════════════════════════════════════════
-- APPLY FOG
-- ═══════════════════════════════════════════════════
local function current_color()
    return Color3.fromHSV(
        math.clamp(FogConfig.Hue, 0, 1),
        math.clamp(FogConfig.Saturation, 0, 1),
        math.clamp(FogConfig.Brightness, 0, 1)
    )
end

local function apply_fog()
    if not FogConfig.Enabled then
        Lighting.FogColor       = Original.FogColor
        Lighting.FogStart       = Original.FogStart
        Lighting.FogEnd         = Original.FogEnd
        Lighting.Ambient        = Original.Ambient
        Lighting.OutdoorAmbient = Original.OutdoorAmbient
        Lighting.Brightness     = Original.Brightness
        update_character_glow()
        return
    end

    local col = current_color()
    Lighting.FogColor = col
    Lighting.FogStart = FogConfig.FogStart
    Lighting.FogEnd   = FogConfig.FogEnd

    if FogConfig.Ambient then
        Lighting.Ambient = col:Lerp(Color3.new(1, 1, 1), 0.35)
    else
        Lighting.Ambient = Original.Ambient
    end

    if FogConfig.OutdoorAmbient then
        Lighting.OutdoorAmbient = col
    else
        Lighting.OutdoorAmbient = Original.OutdoorAmbient
    end

    if FogConfig.BrightnessGate then
        Lighting.Brightness = FogConfig.BrightnessValue
    else
        Lighting.Brightness = Original.Brightness
    end
    
    update_character_glow()
end

